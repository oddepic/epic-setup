<Window x:Class="EpicSetup.Windows.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:vm="clr-namespace:EpicSetup.ViewModels"
        xmlns:cv="clr-namespace:EpicSetup.Converters"
        xmlns:md="clr-namespace:EpicSetup.Models"
        xmlns:ctl="clr-namespace:EpicSetup.Controls"
        Title="epic setup"
        Height="660" Width="1000"
        MinHeight="560" MinWidth="860"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <cv:InverseBooleanToVisibilityConverter x:Key="InvBoolVis" />
        <cv:BooleanToVisibilityConverter x:Key="BoolVis" />
        <cv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <cv:InverseBooleanConverter x:Key="NotBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Padding="20,14" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="epic setup" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CatalogSourceText}" Style="{StaticResource SmallMuted}"
                               VerticalAlignment="Center" Margin="12,3,0,0"/>
                </StackPanel>

                <!-- Category filter (hidden while reviewing) -->
                <ComboBox Style="{StaticResource CategoryFilterCombo}"
                          ItemsSource="{Binding CategoryFilter}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="{Binding IsReviewing, Converter={StaticResource InvBoolVis}}"/>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1" Margin="18,14,18,14">
            <!-- ===== Step 1: Select ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                           Visibility="{Binding IsReviewing, Converter={StaticResource InvBoolVis}}"
                           IsEnabled="{Binding SelectionEnabled}">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:MasonryPanel MaxItemWidth="440" ColumnGap="22" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryVm}">
                            <Border Style="{StaticResource CategoryBlock}">
                                <StackPanel>
<!-- Category header -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsThreeState="True"
                                                   IsChecked="{Binding HeaderCheck, Mode=TwoWay}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource AppHeaderText}"
                                                   Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource AppHeaderText}"
                                                   Text="{Binding Hint, StringFormat=' ({0})'}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Hint}"
                                                   Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}"/>
                                        <Border Grid.Column="3" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Style="{StaticResource TinyMonoText}" VerticalAlignment="Center">
                                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Count, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Apps -->
                                    <ItemsControl ItemsSource="{Binding Apps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AppEntryVm}">
                                                <Border Style="{StaticResource AppRow}">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              ToolTip="{Binding SizeLabel}">
                                                        <CheckBox.Content>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Icon / letter chip -->
                                                                <Border Style="{StaticResource LetterChip}" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                                                                    <TextBlock Style="{StaticResource LetterChipText}"
                                                                               Text="{Binding IconInitial}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource LetterChip}" Padding="2" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                                                                    <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                                                </Border>
                                                                <TextBlock Style="{StaticResource AppNameText}"
                                                                           Text="{Binding Name}" Margin="9,0,0,0"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Visibility="{Binding HasCliTag, Converter={StaticResource BoolVis}}"
                                                                        Background="#22AAA3B5" CornerRadius="5" Padding="6,1"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource ChipText}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="CLI"/>
                                                                </Border>
                                                                <Border Visibility="{Binding HasTuiTag, Converter={StaticResource BoolVis}}"
                                                                        Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="6,1"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource ChipText}"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               Text="TUI"/>
                                                                </Border>
                                                                <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"
                                                                        Background="#26D8B36A" CornerRadius="5" Padding="6,1"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource ChipText}"
                                                                               Foreground="{StaticResource WarnBrush}"
                                                                               Text="REVIEW"/>
                                                                </Border>
                                                                <Border Visibility="{Binding HasManualSetup, Converter={StaticResource BoolVis}}"
                                                                        Background="#267EA9D8" CornerRadius="5" Padding="6,1"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource ChipText}"
                                                                               Foreground="{StaticResource InfoBrush}"
                                                                               Text="REQ. SETUP"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </CheckBox.Content>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== Step 2: Review + Install (one unified list) ===== -->
            <Grid Visibility="{Binding IsReviewing, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title row -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Queue" Style="{StaticResource TitleText}" VerticalAlignment="Center"
                                   Visibility="{Binding IsInstalling, Converter={StaticResource InvBoolVis}}"/>
                        <TextBlock Text="{Binding StageTitle}" Style="{StaticResource TitleText}" VerticalAlignment="Center"
                                   ToolTip="Downloads and installs the staged apps"
                                   Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"/>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="8,3" Margin="10,1,0,0"
                                VerticalAlignment="Center" ToolTip="Apps staged for installation"
                                Visibility="{Binding IsReviewing, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource TinyMonoText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding ReviewItems.Count, Mode=OneWay}"/><Run Text=" staged"/>
                            </TextBlock>
                        </Border>
                        <Border Background="Transparent" CornerRadius="5" Padding="8,3" Margin="6,1,0,0"
                                VerticalAlignment="Center" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                Visibility="Collapsed" Loaded="SizeChip_Loaded" ToolTip="Estimated download size of the staged apps">
                            <TextBlock Text="0 MB" Style="{StaticResource TinyMonoText}"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Border x:Name="SizeChip" Background="Transparent" CornerRadius="5" Padding="8,3" Margin="10,1,0,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                            HorizontalAlignment="Right" Visibility="Collapsed"
                            ToolTip="Estimated download size of the staged apps">
                        <TextBlock x:Name="SizeValue" Style="{StaticResource TinyMonoText}"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Text="0 MB"/>
                    </Border>
                </Grid>

                <!-- Counter + percent (install only) -->
                <Grid Grid.Row="1" Margin="2,10,2,4"
                      Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding StepsCounterLabel, Mode=OneWay}" Style="{StaticResource SmallMuted}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StepsPercentLabel, Mode=OneWay}" Style="{StaticResource TinyMonoText}"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Overall bar (install only), aligned with the list below -->
                <ProgressBar Grid.Row="2" Height="4" Margin="2,0,2,0" Maximum="1"
                             Value="{Binding OverallStepsFraction, Mode=OneWay}"
                             Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"/>

                <!-- Content: steps left, live output right -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ReviewItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AppEntryVm}">
                                    <Border CornerRadius="5" Padding="10,7" Margin="0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Failed}">
                                                        <Setter Property="Background" Value="#16D47787"/>
                                                        <Setter Property="BorderBrush" Value="#33D47787"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsProcessing}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Slot 1: remove button (review) / state glyph (install) -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RemoveButton}"
                                                        Command="{Binding DataContext.RemoveAppCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsInstalling, ElementName=Root, Converter={StaticResource InvBoolVis}}"/>
                                                <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding DataContext.IsInstalling, ElementName=Root, Converter={StaticResource BoolVis}}">
                                                    <Ellipse Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Fill="{StaticResource TextMutedBrush}" Opacity="0.45">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Succeeded}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Failed}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Skipped}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Grid Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="{Binding IsProcessing, Converter={StaticResource BoolVis}}">
                                                        <Ellipse Width="11" Height="11" StrokeThickness="2"
                                                                 Stroke="{StaticResource InfoBrush}"
                                                                 StrokeDashArray="4.5 2.5" StrokeDashCap="Round">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                                                                         From="0" To="7" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    </Grid>
                                                    <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 1,6 L 4.5,9.5 L 11,2" Stroke="{StaticResource SuccessBrush}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Succeeded}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{StaticResource ErrorBrush}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Failed}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Rectangle Width="9" Height="3" RadiusX="1.5" RadiusY="1.5"
                                                               Fill="{StaticResource WarnBrush}">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Skipped}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </Grid>
                                            </Grid>

                                            <!-- Slot 2: app icon, fixed column so names align -->
                                            <Border Grid.Column="1" Width="20" Height="20" CornerRadius="4"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Style="{StaticResource LetterChipText}" Text="{Binding IconInitial}"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}"/>
                                                    <Image Source="{Binding Icon}" Stretch="Uniform" Margin="2"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Slot 3: name -->
                                            <TextBlock Grid.Column="2" Style="{StaticResource AppNameText}" Text="{Binding Name}"
                                                       VerticalAlignment="Center" Margin="10,0,8,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>

                                            <!-- Slot 4: verdict pill + elapsed + live detail -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border CornerRadius="5" Padding="8,2"
                                                        ToolTip="{Binding StatusText}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Succeeded}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="#2267C59A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Failed}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="#22D47787"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Skipped}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Background" Value="#22D8B36A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Failed}">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                        <Setter Property="Text" Value="FAILED"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Succeeded}">
                                                                        <Setter Property="Text" Value="INSTALLED"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Skipped}">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                                        <Setter Property="Text" Value="SKIPPED"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding ElapsedLabel, Mode=OneWay}"
                                                           FontFamily="{StaticResource JetBrainsMono}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                           MinWidth="34" TextAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElapsedLabel}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Live output panel; show/hide details collapses it.
                         Stays available after the run ends (DetailsOpen). -->
                    <Border Grid.Column="1" Width="450" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Margin="14,0,0,0"
                            Visibility="{Binding DetailsOpen, Converter={StaticResource BoolVis}}">
                        <Grid Margin="14,10,10,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="2,0,4,8">
                                <TextBlock Text="Live output" Style="{StaticResource AppHeaderText}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LogLines.Count, Mode=OneWay}" Style="{StaticResource TinyMonoText}"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" lines" Style="{StaticResource TinyMonoText}"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="DetailsBox"
                                     Grid.Row="1"
                                     Text="{Binding LogText, Mode=OneWay}"
                                     FontFamily="{StaticResource JetBrainsMono}" FontSize="11"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="2,0,4,6"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Footer ===================== -->
        <Border Grid.Row="2" Padding="20,12,20,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status line in selection phase, details toggle once reviewing -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SmallMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding InstalledAppsTooltip}"
                               Visibility="{Binding IsReviewing, Converter={StaticResource InvBoolVis}}"/>
                    <Button Style="{StaticResource GhostButton}" Padding="12,7"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Command="{Binding ToggleDetailsCommand}"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolVis}}"
                            ToolTip="Full engine log - stays open after the run ends">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailsChevron" Text="&#xEA61;" FontFamily="{StaticResource TablerIcons}"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DetailsToggleLabel" Text="show details" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Right: flow actions -->
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Content="{Binding ContinueLabel}"
                        Command="{Binding ContinueCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsReviewing, Converter={StaticResource InvBoolVis}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="{Binding IsReviewing, Converter={StaticResource BoolVis}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Style="{StaticResource GhostButton}" Content="Back"
                            Command="{Binding BackCommand}" Margin="0,0,8,0"
                            IsEnabled="{Binding IsInstalling, Converter={StaticResource NotBool}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Install queue"
                            Command="{Binding InstallCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Loading overlay ===================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#B3000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading catalog…" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                <ProgressBar Width="180" Margin="0,12,0,0" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
