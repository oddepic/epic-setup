<Window x:Class="EpicSetup.Windows.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EpicSetup.ViewModels"
        xmlns:cv="clr-namespace:EpicSetup.Converters"
        xmlns:md="clr-namespace:EpicSetup.Models"
        xmlns:ctl="clr-namespace:EpicSetup.Controls"
        Title="Epic Setup"
        Height="660" Width="1000"
        MinHeight="560" MinWidth="860"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <cv:InverseBooleanToVisibilityConverter x:Key="InvBoolVis" />
        <cv:BooleanToVisibilityConverter x:Key="BoolVis" />
        <cv:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <cv:InverseBooleanConverter x:Key="NotBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Padding="20,14" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="epic setup" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CatalogSourceText}" Style="{StaticResource SmallMuted}"
                               VerticalAlignment="Center" Margin="12,3,0,0"/>
                </StackPanel>

                <!-- Tabs (hidden while reviewing) -->
                <ItemsControl ItemsSource="{Binding Tabs}" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Visibility="{Binding IsReviewing, Converter={StaticResource InvBoolVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabVm}">
                            <RadioButton Style="{StaticResource TabButton}" Content="{Binding Name}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,4,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1" Margin="18,14,18,14">
            <!-- ===== Step 1: Select ===== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                           Visibility="{Binding IsReviewing, Converter={StaticResource InvBoolVis}}"
                           IsEnabled="{Binding SelectionEnabled}">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctl:MasonryPanel MaxItemWidth="440" ColumnGap="22" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryVm}">
                            <Border Style="{StaticResource CategoryBlock}">
                                <StackPanel>
<!-- Category header -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsThreeState="True"
                                                   IsChecked="{Binding HeaderCheck, Mode=TwoWay}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource AppHeaderText}"
                                                   Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource AppHeaderText}"
                                                   Text="{Binding Hint, StringFormat=' ({0})'}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Hint}"
                                                   Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}"/>
                                        <Border Grid.Column="3" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Style="{StaticResource TinyMonoText}" VerticalAlignment="Center">
                                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Count, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Apps -->
                                    <ItemsControl ItemsSource="{Binding Apps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AppEntryVm}">
                                                <Border Style="{StaticResource AppRow}">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              ToolTip="{Binding SizeLabel}">
                                                        <CheckBox.Content>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Icon / letter chip -->
                                                                <Border Style="{StaticResource LetterChip}" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                                                                    <TextBlock Style="{StaticResource LetterChipText}"
                                                                               Text="{Binding IconInitial}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource LetterChip}" Padding="2" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                                                                    <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                                                </Border>
                                                                <TextBlock Style="{StaticResource AppNameText}"
                                                                           Text="{Binding Name}" Margin="9,0,0,0"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"
                                                                        Background="#3A2E1A" CornerRadius="3" Padding="6,1"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource ChipText}"
                                                                               Foreground="{StaticResource WarnBrush}"
                                                                               Text="REVIEW"/>
                                                                </Border>
                                                                <Border Visibility="{Binding HasManualSetup, Converter={StaticResource BoolVis}}"
                                                                        Background="#103A5C" CornerRadius="3" Padding="6,1"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource ChipText}"
                                                                               Foreground="{StaticResource InfoBrush}"
                                                                               Text="REQ. SETUP"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </CheckBox.Content>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== Step 2: Review ===== -->
            <Grid Visibility="{Binding IsReviewing, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Review" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,3,0,0">
                            <Run Text="{Binding ReviewItems.Count, Mode=OneWay}"/><Run Text=" apps queued"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ReviewItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AppEntryVm}">
                                <Border Style="{StaticResource AppRow}" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Remove button (left) -->
                                        <Button Grid.Column="0" Style="{StaticResource RemoveButton}"
                                                Command="{Binding DataContext.RemoveAppCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,10,0"
                                                IsEnabled="{Binding IsInstalling, ElementName=Root, Converter={StaticResource NotBool}}"/>

                                        <!-- Icon chip -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource LetterChip}" VerticalAlignment="Center"
                                                    Visibility="{Binding HasIcon, Converter={StaticResource InvBoolVis}}">
                                                <TextBlock Style="{StaticResource LetterChipText}"
                                                           Text="{Binding IconInitial}"/>
                                            </Border>
                                            <Border Style="{StaticResource LetterChip}" Padding="2" VerticalAlignment="Center"
                                                    Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                                                <Image Source="{Binding Icon}" Stretch="Uniform"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Name -->
                                        <TextBlock Grid.Column="2" Style="{StaticResource AppNameText}" Text="{Binding Name}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>

                                        <!-- Error message (right-aligned, left of the dot, only on failure) -->
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Right" MaxWidth="340">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TinyMonoText}">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Failed}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Status dot (right) -->
                                        <Ellipse Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Succeeded}">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Failed}">
                                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Downloading}">
                                                            <Setter Property="Fill" Value="{StaticResource InfoBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Verifying}">
                                                            <Setter Property="Fill" Value="{StaticResource InfoBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static md:AppStatus.Installing}">
                                                            <Setter Property="Fill" Value="{StaticResource InfoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- ===================== Footer ===================== -->
        <Border Grid.Row="2" Padding="20,2,20,4" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Top: current status and progress -->
                <Grid Grid.Row="0" Grid.Column="0" MinHeight="40" VerticalAlignment="Top">

                    <Grid MinHeight="40" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SmallMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InstalledAppsTooltip}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsInstalling, Converter={StaticResource InvBoolVis}}"/>
                        <Grid Visibility="{Binding IsInstalling, Converter={StaticResource BoolVis}}"
                              Margin="0,16,0,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DownloadPercentText}"
                                       Style="{StaticResource TinyMonoText}"
                                       TextAlignment="Left" Margin="0" VerticalAlignment="Top"/>
                            <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding DownloadProgress}"
                                         Margin="8,4,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </Grid>

                </Grid>

                <!-- Centered action button(s) -->
                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                        Style="{StaticResource PrimaryButton}"
                        Content="{Binding ContinueLabel}"
                        Command="{Binding ContinueCommand}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsReviewing, Converter={StaticResource InvBoolVis}}"/>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsReviewing, Converter={StaticResource BoolVis}}">
                    <Button Style="{StaticResource GhostButton}" Content="Back"
                            Command="{Binding BackCommand}" Margin="0,0,8,0"
                            IsEnabled="{Binding IsInstalling, Converter={StaticResource NotBool}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Install all"
                            Command="{Binding InstallCommand}"/>
                </StackPanel>

                <!-- Bottom: one-line backend diagnostic -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding BackendLogText}"
                           Style="{StaticResource TinyMonoText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===================== Loading overlay ===================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#B3000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading catalog…" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                <ProgressBar Width="180" Margin="0,12,0,0" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
